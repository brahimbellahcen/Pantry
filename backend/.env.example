# Environment — copy to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql://grocery_user:grocery_pass@localhost:5432/grocery_db

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
APP_ENV=development          # development | production
APP_CORS_ORIGINS=http://localhost:5173

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=...
EMAIL_FROM=Pantry <no-reply@example.com>

# --- Monitoring ---
SENTRY_DSN=                  # Leave blank to disable

# --- Storage (S3 / R2 / MinIO / Spaces) ---
S3_BUCKET=                   # Leave blank to use local /uploads fallback
S3_REGION=us-east-1
S3_ENDPOINT_URL=             # Only for non-AWS providers (e.g. https://xxx.r2.cloudflarestorage.com)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
