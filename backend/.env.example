# Pantry — Environment Variables
# Copy this file to .env and fill in the values.
# Every service listed here has a FREE tier — no credit card needed to get started.

# ── Database ──────────────────────────────────────────────────────────────────
# Free options:
#   • Supabase   https://supabase.com        → 500 MB, always-free
#   • Neon       https://neon.tech           → 0.5 GB, always-free serverless Postgres
#   • Railway    https://railway.app         → $5/month hobby credit (covers small apps)
DATABASE_URL=postgresql://grocery_user:grocery_pass@localhost:5432/grocery_db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_CORS_ORIGINS=http://localhost:5173

# ── Email — Resend (FREE: 3 000 emails/month) ─────────────────────────────────
# Sign up at https://resend.com → API Keys → Create API Key (takes 2 minutes)
# Without this key, emails are silently skipped in development.
RESEND_API_KEY=              # re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Pantry <onboarding@resend.dev>
# Once you verify a domain on Resend, change EMAIL_FROM to your domain:
# EMAIL_FROM=Pantry <hello@yourdomain.com>

# ── Image Storage — Cloudinary (FREE: 25 GB storage + 25 GB bandwidth) ────────
# Sign up at https://cloudinary.com → Dashboard → copy the three values below.
# Without these, images are saved to a local /uploads folder (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payment ───────────────────────────────────────────────────────────────────
# Default payment method is "cod" (Cash on Delivery) — no API keys needed.
# Supported values in checkout: "cod", "bank_transfer"
# Bank transfer details can be shown in the order confirmation email.
